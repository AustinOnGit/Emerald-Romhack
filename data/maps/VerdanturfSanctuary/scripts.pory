script VerdanturfSanctuary_EventScript_Lacey_Battle{
    trainerbattle_single(TRAINER_LACEY, LaceyIntro, LaceyOutro)
    msgbox(LaceyBeaten, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}


text LaceyIntro{
    "I'll show you the power of the sun!\n"
}

text LaceyOutro{
    "I guess my sun has set...\n"
}

text LaceyBeaten{
    "I'm training to be as great as FLANNERY\n"
    "one day. Isn't her Torkoal the cutest?\n"    
}

